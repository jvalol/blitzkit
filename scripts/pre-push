#!/usr/bin/env bash
#
# pre-push — do not publish a site that does not match the engine.
#
# Pushing this repo is deploying it: Netlify builds on a push to main, so
# whatever is in web/ at that moment is what a stranger plays. On 2026-10-16
# the published arcade was a day old and a whole room was missing from it, and
# nothing anywhere said so. check-listings asks whether a build exists and is
# offered, never whether it is current.
#
# **It refuses rather than building.** Building takes minutes and, worse,
# would leave the rebuilt files uncommitted behind the push, so the thing that
# went out and the thing in the tree would disagree in a new way. A refusal
# with the command in it is slower to obey and leaves the repo honest.
#
# Only the browser builds are a gate. The clips and the stills drift too, and
# ./check-fresh reports on them, but what they are made from is the whole
# engine and a gate on that would refuse every push after any engine change.
#
# Install: ln -sf ../../scripts/pre-push .git/hooks/pre-push
# Skip once, knowing what it is for: git push --no-verify

set -uo pipefail

# The project root, which is a directory up from this repo and holds the
# scripts this needs. Found by looking for them rather than by counting
# directories: git runs a hook as .git/hooks/pre-push and this file lives at
# scripts/pre-push, so how far up ".." goes depends on which path git hands
# over, and a hook that silently does nothing is worse than no hook.
root=$(git rev-parse --show-toplevel 2>/dev/null)/..
root=$(cd "$root" 2>/dev/null && pwd) || exit 0

if [ ! -x "$root/check-fresh" ]; then
  echo "pre-push: no ./check-fresh above this repo, so nothing was checked." >&2
  exit 0
fi

cd "$root" || exit 0

# the gate this repo already had, which is about copy and not about freshness
if [ -x blitzkit/scripts/ship-check ]; then
  if ! blitzkit/scripts/ship-check; then
    echo
    echo "pre-push: stopped by ship-check above."
    exit 1
  fi
fi

# and whether any string going out is still a draft. ./check-copy with no
# repo named asks every one of them, which is right here for the reason the
# check-voice loop below gives at length: the ./build-web further down
# compiles each game's working tree into the wasm this push serves, so a
# marker sitting in a game is published by a push of the engine.
#
# ship-check above reads this crate's readme and site. A marker in a game's
# Rust was outside both that and check-voice's .copy-files, and was caught
# only by ./check-all, which nobody runs before a push.
if [ -x ./check-copy ]; then
  if ! ./check-copy; then
    echo
    echo "pre-push: stopped by check-copy above."
    echo "          pushing this repo publishes those repos' browser builds."
    exit 1
  fi
fi

# and whether the copy going out is copy he signed, which is the same
# question ship-check asks and a stronger form of it: a marker he struck
# months ago guards nothing written into that page since. See
# ~/.claude/voice/check-voice. Skipped where it is not installed.
#
# **Every repo this publishes, and not only this one.** It asked only
# blitzkit's ten copy files, and the ./build-web below compiles each
# game's working tree into the wasm this push serves. So a game carrying
# words Jake had not read could be published by a push of the engine and
# nothing anywhere would have said so. On 2026-11-06 the arcade sat with
# seven unsigned lines in `src/says.rs` while this hook was the last gate
# before the site, and the only reason they did not go out is that
# somebody thought about it.
#
# Read off ./list-repos rather than a list here, for the reason
# check-all's own note gives: securitysweep was in one list and not the
# other and went unchecked for months.
if [ -x "$HOME/.claude/voice/check-voice" ]; then
  for repo in $(./list-repos 2>/dev/null); do
    [ -d "$repo" ] || continue

    if ! (cd "$repo" && "$HOME/.claude/voice/check-voice"); then
      echo
      echo "pre-push: stopped by check-voice in $repo above."
      echo "          pushing this repo publishes that one's browser build."
      exit 1
    fi
  done
fi

# and whether the site promises an engine anybody can install. Pushing
# deploys it, and a reader of it runs cargo add blitzkit and gets the
# newest tag: on 2026-11-03 the testing page documented PICTURES_REQUIRED
# while 0.14.0 was the published crate, and nothing in the repo could see
# it. See scripts/check-site for what it does and does not ask.
# named from the project root, which is where this hook stands: it cd's up
# one so it can reach ./check-fresh, and a path relative to this crate
# silently finds nothing there. ship-check was wrong the same way until
# 2026-11-03.
if [ -x blitzkit/scripts/check-site ]; then
  if ! blitzkit/scripts/check-site; then
    echo
    echo "pre-push: stopped by check-site above."
    exit 1
  fi
fi

# **And what the tree holds that the commit does not.**
#
# Everything below reads `web/MADE`, and `web/MADE` is a file the rebuild
# writes. So the refusal at the bottom of this leaves the rebuilt build
# in the tree *and* a manifest saying the build is level, and the push
# you try straight after goes through: `behind` comes back empty,
# neither branch below runs, and what goes out is the commit with the
# old build still published. That happened on 2026-11-02. The clip of a
# room went out and the wasm of that room did not, which is the exact
# thing this file exists to stop, arrived at through the file itself.
#
# A commit is what gets pushed, so the question is whether `web` in the
# tree is the `web` in the commit, and it is asked of the tree rather
# than of anything a build writes. The manifest is left out for the same
# reason the rebuild below leaves it out: it is a record of when, not a
# thing anybody plays.
loose=$(git -C blitzkit status --porcelain -- web | grep -v '^.. web/MADE$' || true)

if [ -n "$loose" ]; then
  echo "pre-push: blitzkit/web holds files the commit does not, and what"
  echo "          gets published is the commit."
  echo
  echo "$loose"
  echo
  echo "  git -C blitzkit add web && git -C blitzkit commit"
  echo
  echo "then push again. git push --no-verify skips this."
  exit 1
fi

[ -x ./check-fresh ] || exit 0

behind=$(./check-fresh 2>/dev/null |
  awk '/^== the examples built for a browser/ {on = 1; next} /^$/ {on = 0} on && /behind/ {print}')

# **A build behind only its own repo may be one nobody could tell from the
# one in the tree.** Nothing here can read a test out of a source file. The
# xanadu keeps a `#[cfg(test)]` const near the top of main.rs,
# `REACH_PAST`, with seventeen thousand lines of game after it, so there is
# no line to cut at and no path to exclude, the way specs and markdown are
# excluded in `behind_source`.
#
# Named rather than given a line, because the line was 62 when this was
# written and is 74 now, and nothing was keeping it.
#
# What can be asked is the artifact. A commit that only adds tests rebuilds
# byte for byte, which is how the one on 2026-11-02 was caught: `./build-web
# arcade` moved the manifest and changed nothing else, and the push it had
# refused was a push of a spec and a test.
#
# Only while the engine itself is level, because an engine commit puts all
# eighteen behind at once and rebuilding eighteen on a push is not a check,
# it is a wait.
if [ -n "$behind" ] && ! printf '%s\n' "$behind" | grep -q "engine commit"; then
  names=$(printf '%s\n' "$behind" | sed 's/^ *//; s/,.*//' | tr '\n' ' ' | sed 's/ *$//')

  echo "pre-push: $names is behind its own repo. Rebuilding to see whether"
  echo "          that changed any bytes."

  # shellcheck disable=SC2086
  if ./build-web $names >/dev/null 2>&1 &&
    git -C blitzkit diff --quiet -- web ':(exclude)web/MADE'; then
    echo "          It did not, so nothing published is stale and this goes"
    echo "          through. The manifest moved and wants committing, which"
    echo "          is what stops this happening on the next push."
    exit 0
  fi

  echo "          It did. Refusing, and the rebuilt files are in the tree."
  echo
fi

if [ -n "$behind" ]; then
  echo "pre-push: the browser builds are behind the engine, and pushing this"
  echo "          repo publishes them."
  echo
  echo "$behind"
  echo
  # **With the `cd`, because this has one and the reader does not.** git runs
  # a hook from the top of the worktree and this script then cd'd to the
  # project root above it, so `./build-web` is a path that resolves here and
  # nowhere the person reading it is standing. On 2026-11-14 Jake ran exactly
  # what this printed, from the repo, and got "no such file or directory".

  # **Whether those repos are pushed themselves, which is the half of this
  # the refusal used to leave out.** `./build-web` compiles a game's working
  # tree, so the commit that carries the bytes here names a commit of that
  # game's. With the game unpushed that is a commit nobody can fetch, and
  # what goes on the site is a build of a state no repo has: the message
  # points at nothing and the bytes cannot be reproduced from anything
  # public. Jake hit it on 2026-11-21, pushing the engine while the arcade
  # stood three commits ahead of its own origin, and the only reason it came
  # out right is that somebody noticed the order.
  # The same names the rebuild above works from, read again here: that one
  # only sets them while the engine is level, and with `set -u` on, reusing
  # it would abort this hook on the one push where the engine itself moved.
  theirs=$(printf '%s\n' "$behind" | sed 's/^ *//; s/,.*//' | tr '\n' ' ' | sed 's/ *$//')

  # **Through `./list-repos` and not off the name.** The lines above say
  # "xanadu" and "starry", and the first of those is a directory at the
  # project root while the second is under `games/`. Read as bare names, every
  # game silently fell through the `-d` below and the one repo this could ever
  # warn about was the arcade.
  unpushed=""
  for name in $theirs; do
    where=$(./list-repos 2>/dev/null | grep -E "(^|/)$name\$" | head -1)
    [ -n "$where" ] && [ -d "$root/$where" ] || continue

    ahead=$(git -C "$root/$where" rev-list --count '@{u}..HEAD' 2>/dev/null) || continue
    [ "${ahead:-0}" -gt 0 ] 2>/dev/null || continue

    unpushed="$unpushed  (cd $root/$where && git push)    # $ahead unpushed"$'\n'
  done

  if [ -n "$unpushed" ]; then
    echo "Those repos are ahead of their own origin, so push them first or the"
    echo "rebuild names a commit nobody else can fetch:"
    echo
    printf '%s' "$unpushed"
    echo
  fi

  echo "build-web is a directory above this repo, so it wants its path."
  echo "It takes a game's name to do one rather than all eighteen:"
  echo
  echo "  (cd $root && ./build-web)"
  echo "  (cd $root && ./build-web xanadu)"
  echo
  echo "then commit web/ here and push again. git push --no-verify skips this."
  exit 1
fi

exit 0
