#!/usr/bin/env bash
#
# pre-push — do not publish a site that does not match the engine.
#
# Pushing this repo is deploying it: Netlify builds on a push to main, so
# whatever is in web/ at that moment is what a stranger plays. On 2026-10-16
# the published arcade was a day old and a whole room was missing from it, and
# nothing anywhere said so. check-listings asks whether a build exists and is
# offered, never whether it is current.
#
# **It refuses rather than building.** Building takes minutes and, worse,
# would leave the rebuilt files uncommitted behind the push, so the thing that
# went out and the thing in the tree would disagree in a new way. A refusal
# with the command in it is slower to obey and leaves the repo honest.
#
# Only the browser builds are a gate. The clips and the stills drift too, and
# ./check-fresh reports on them, but what they are made from is the whole
# engine and a gate on that would refuse every push after any engine change.
#
# Install: ln -sf ../../scripts/pre-push .git/hooks/pre-push
# Skip once, knowing what it is for: git push --no-verify

set -uo pipefail

# The project root, which is a directory up from this repo and holds the
# scripts this needs. Found by looking for them rather than by counting
# directories: git runs a hook as .git/hooks/pre-push and this file lives at
# scripts/pre-push, so how far up ".." goes depends on which path git hands
# over, and a hook that silently does nothing is worse than no hook.
root=$(git rev-parse --show-toplevel 2>/dev/null)/..
root=$(cd "$root" 2>/dev/null && pwd) || exit 0

if [ ! -x "$root/check-fresh" ]; then
  echo "pre-push: no ./check-fresh above this repo, so nothing was checked." >&2
  exit 0
fi

cd "$root" || exit 0

# the gate this repo already had, which is about copy and not about freshness
if [ -x blitzkit/scripts/ship-check ]; then
  if ! blitzkit/scripts/ship-check; then
    echo
    echo "pre-push: stopped by ship-check above."
    exit 1
  fi
fi

# **And what the tree holds that the commit does not.**
#
# Everything below reads `web/MADE`, and `web/MADE` is a file the rebuild
# writes. So the refusal at the bottom of this leaves the rebuilt build
# in the tree *and* a manifest saying the build is level, and the push
# you try straight after goes through: `behind` comes back empty,
# neither branch below runs, and what goes out is the commit with the
# old build still published. That happened on 2026-11-02. The clip of a
# room went out and the wasm of that room did not, which is the exact
# thing this file exists to stop, arrived at through the file itself.
#
# A commit is what gets pushed, so the question is whether `web` in the
# tree is the `web` in the commit, and it is asked of the tree rather
# than of anything a build writes. The manifest is left out for the same
# reason the rebuild below leaves it out: it is a record of when, not a
# thing anybody plays.
loose=$(git -C blitzkit status --porcelain -- web | grep -v '^.. web/MADE$' || true)

if [ -n "$loose" ]; then
  echo "pre-push: blitzkit/web holds files the commit does not, and what"
  echo "          gets published is the commit."
  echo
  echo "$loose"
  echo
  echo "  git -C blitzkit add web && git -C blitzkit commit"
  echo
  echo "then push again. git push --no-verify skips this."
  exit 1
fi

[ -x ./check-fresh ] || exit 0

behind=$(./check-fresh 2>/dev/null |
  awk '/^== the examples built for a browser/ {on = 1; next} /^$/ {on = 0} on && /behind/ {print}')

# **A build behind only its own repo may be one nobody could tell from the
# one in the tree.** Nothing here can read a test out of a source file. The
# arcade keeps a `#[cfg(test)]` const at main.rs line 62 with fourteen
# thousand lines of game after it, so there is no line to cut at and no path
# to exclude, the way specs and markdown are excluded in `behind_source`.
#
# What can be asked is the artifact. A commit that only adds tests rebuilds
# byte for byte, which is how the one on 2026-11-02 was caught: `./build-web
# arcade` moved the manifest and changed nothing else, and the push it had
# refused was a push of a spec and a test.
#
# Only while the engine itself is level, because an engine commit puts all
# eighteen behind at once and rebuilding eighteen on a push is not a check,
# it is a wait.
if [ -n "$behind" ] && ! printf '%s\n' "$behind" | grep -q "engine commit"; then
  names=$(printf '%s\n' "$behind" | sed 's/^ *//; s/,.*//' | tr '\n' ' ' | sed 's/ *$//')

  echo "pre-push: $names is behind its own repo. Rebuilding to see whether"
  echo "          that changed any bytes."

  # shellcheck disable=SC2086
  if ./build-web $names >/dev/null 2>&1 &&
    git -C blitzkit diff --quiet -- web ':(exclude)web/MADE'; then
    echo "          It did not, so nothing published is stale and this goes"
    echo "          through. The manifest moved and wants committing, which"
    echo "          is what stops this happening on the next push."
    exit 0
  fi

  echo "          It did. Refusing, and the rebuilt files are in the tree."
  echo
fi

if [ -n "$behind" ]; then
  echo "pre-push: the browser builds are behind the engine, and pushing this"
  echo "          repo publishes them."
  echo
  echo "$behind"
  echo
  echo "  ./build-web          to bring them all up"
  echo "  ./build-web arcade   for one"
  echo
  echo "then commit web/ and push again. git push --no-verify skips this."
  exit 1
fi

exit 0
